#!/bin/sh
# Writes the daemon's settings from the install wizard.
. "$(dirname "$0")/common"

# An upgrade has no wizard. Keep the settings from the install.
if [ -z "${wizard_share:-}" ] && [ -f "$CONFIG" ]; then
    exit 0
fi

# An empty folder name means the shared folder itself, for music that is already there.
ROOT="$(share_path "$wizard_share")"
SMB_PATH="$wizard_share"
if [ -n "${wizard_folder:-}" ]; then
    ROOT="$ROOT/$wizard_folder"
    SMB_PATH="$SMB_PATH/$wizard_folder"
fi
mkdir -p "$ROOT" "$SYNOPKG_PKGVAR/data"
HOST=$(hostname)

{
    echo "root = \"$ROOT\""
    echo "data = \"$SYNOPKG_PKGVAR/data\""
    echo "name = \"$HOST\""
    echo "smb_share = \"smb://$HOST.local/$SMB_PATH\""
    limit=$(echo "$wizard_limit" | tr -d ' ')
    [ -n "$limit" ] && echo "limit = \"$limit\""
} > "$CONFIG"
exit 0
